# Copy to .env for local PostgreSQL-backed development. Without DATABASE_URL,
# the API uses an in-memory demo dataset and demo credentials.
DATABASE_URL=postgresql://serein:serein@localhost:5432/serein?schema=public
JWT_SECRET=replace-with-a-random-32-byte-secret
CLIENT_ORIGIN=http://localhost:5173
PORT=4000
FX_USD_INR=83.5

# Optional stretch features: BullMQ notifications require Redis and SMTP.
REDIS_URL=redis://localhost:6379
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Serein Stays <hello@example.com>

# Required only when running the PostgreSQL seed script for a real database.
SEED_ADMIN_EMAIL=admin@yourhotel.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password

# Local frontend defaults to /api; Vite proxies it to localhost:4000.
# Vercel deployment: set API_ORIGIN server-side (the Render API origin) and build with VITE_API_URL=/api.
API_ORIGIN=
VITE_API_URL=
