generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  email        String         @unique
  passwordHash String
  role         String         @default("user")
  createdAt    DateTime       @default(now())
  bookings     Booking[]
  reviews      Review[]
  refreshTokens RefreshToken[]
}

model Property {
  id           String     @id @default(uuid()) @db.Uuid
  slug         String     @unique
  name         String
  description  String
  address      String
  neighborhood String
  city         String     @default("Mumbai")
  country      String     @default("India")
  rating       Float      @default(4.7)
  amenities    String[]   @default([])
  heroImage    String     @default("/hotel-hero.jpg")
  featured     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  roomTypes    RoomType[]
  bookings     Booking[]
  reviews      Review[]
}

model RoomType {
  id           String   @id @default(uuid()) @db.Uuid
  propertyId   String   @db.Uuid
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name         String
  sourceLabel  String
  description  String
  maxGuests    Int      @default(2)
  inventory    Int      @default(1)
  basePrice    Decimal  @db.Decimal(12, 2)
  currency     String   @default("INR")
  priceInr     Decimal  @db.Decimal(12, 2)
  amenities    String[] @default([])
  bookings     Booking[]
  createdAt    DateTime @default(now())

  @@index([propertyId])
}

model Booking {
  id            String   @id @default(uuid()) @db.Uuid
  confirmation  String   @unique
  userId        String?  @db.Uuid
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  propertyId    String   @db.Uuid
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  roomTypeId    String   @db.Uuid
  roomType      RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  guestName     String
  guestEmail    String
  guestPhone    String?
  checkIn       DateTime @db.Date
  checkOut      DateTime @db.Date
  guests        Int      @default(2)
  status        String   @default("confirmed")
  totalPrice    Decimal  @db.Decimal(12, 2)
  currency      String   @default("INR")
  sourceRecord  String?
  createdAt     DateTime @default(now())

  @@index([roomTypeId, status, checkIn, checkOut])
  @@index([propertyId, checkIn])
  @@index([userId, checkIn])
  @@index([createdAt])
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String?  @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestName  String
  rating     Int
  title      String
  comment    String
  createdAt  DateTime @default(now())

  @@index([propertyId, createdAt])
}

model Inquiry {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  email      String
  phone      String?
  message    String
  checkIn    DateTime? @db.Date
  checkOut   DateTime? @db.Date
  status     String   @default("new")
  createdAt  DateTime @default(now())

  @@index([status, createdAt])
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model ImportIssue {
  id           String   @id @default(uuid()) @db.Uuid
  sourceRecord String
  entity       String
  issue        String
  payload      Json
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())
}
